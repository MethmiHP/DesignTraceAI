[
  {
    "case_id": "LLM-001",
    "project_id": "hospital_management",
    "domain": "Healthcare",
    "difficulty": "easy",
    "requirements": [
      {
        "requirement_id": "FR-001",
        "text": "The system shall register patients with their full name, email address, and phone number."
      },
      {
        "requirement_id": "FR-002",
        "text": "The system shall store doctors with their name and specialization."
      },
      {
        "requirement_id": "FR-003",
        "text": "Patients shall book appointments with doctors for a selected date and time."
      }
    ],
    "architecture_context": {
      "database_type": "relational",
      "target_dbms": "PostgreSQL"
    },
    "expected_design": {
      "entities": [
        "patients",
        "doctors",
        "appointments"
      ],
      "attributes": {
        "patients": [
          "patient_id",
          "full_name",
          "email",
          "phone"
        ],
        "doctors": [
          "doctor_id",
          "name",
          "specialization"
        ],
        "appointments": [
          "appointment_id",
          "patient_id",
          "doctor_id",
          "appointment_datetime"
        ]
      },
      "primary_keys": {
        "patients": "patient_id",
        "doctors": "doctor_id",
        "appointments": "appointment_id"
      },
      "foreign_keys": [
        {
          "table": "appointments",
          "column": "patient_id",
          "references": "patients.patient_id"
        },
        {
          "table": "appointments",
          "column": "doctor_id",
          "references": "doctors.doctor_id"
        }
      ],
      "relationships": [
        {
          "from": "patients",
          "to": "appointments",
          "cardinality": "one-to-many"
        },
        {
          "from": "doctors",
          "to": "appointments",
          "cardinality": "one-to-many"
        }
      ],
      "constraints": [
        "patients.email should be unique"
      ],
      "requirement_mapping": {
        "FR-001": ["patients"],
        "FR-002": ["doctors"],
        "FR-003": ["appointments"]
      }
    }
  },
