{
  "project_id": "banking-security-choice-test",
  "functional_requirements": [
    {
      "requirement_id": "FR-001",
      "statement": "A customer shall view a bank account.",
      "priority": "High"
    },
    {
      "requirement_id": "FR-002",
      "statement": "A customer shall create a bank account.",
      "priority": "High"
    },
    {
      "requirement_id": "FR-003",
      "statement": "A customer shall submit a transfer between bank accounts.",
      "priority": "High"
    }
  ],
  "architecture": {
    "architecture_id": "ARCH-001",
    "selected_architecture": "Microservices Architecture",
    "elements": [
      {
        "element_id": "COMP-BANK-ACCOUNT",
        "name": "Bank Account Service",
        "type": "Service",
        "main_responsibility": "Manage customer bank accounts."
      },
      {
        "element_id": "COMP-TRANSFER",
        "name": "Transfer Service",
        "type": "Service",
        "main_responsibility": "Submit and manage transfers between bank accounts."
      }
    ]
  },
  "database": {
    "entities": [
      {
        "entity_id": "DB-BANK-ACCOUNT",
        "name": "Bank Account",
        "attributes": [
          "bank_account_id",
          "customer_id",
          "account_number",
          "account_type",
          "balance",
          "status"
        ],
        "primary_key": "bank_account_id",
        "foreign_keys": [
          "customer_id -> Customer"
        ],
        "constraints": []
      },
      {
        "entity_id": "DB-CUSTOMER",
        "name": "Customer",
        "attributes": [
          "customer_id",
          "name"
        ],
        "primary_key": "customer_id",
        "foreign_keys": [],
        "constraints": []
      },
      {
        "entity_id": "DB-TRANSFER",
        "name": "Transfer",
        "attributes": [
          "transfer_id",
          "source_account_id",
          "destination_account_id",
          "amount",
          "status",
          "created_at"
        ],
        "primary_key": "transfer_id",
        "foreign_keys": [
          "source_account_id -> Bank Account",
          "destination_account_id -> Bank Account"
        ],
        "constraints": [
          "amount > 0",
          "source_account_id != destination_account_id"
        ]
      }
    ],
    "relationships": [
      "Customer owns Bank Account",
      "Transfer references source and destination Bank Accounts"
    ],
    "constraints": []
  },
  "non_functional_requirements": [
    {
      "requirement_id": "NFR-001",
      "statement": "Only authenticated customers shall access protected banking operations.",
      "category": "Security"
    }
  ]
}
