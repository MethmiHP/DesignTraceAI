        "requirement_id": "FR-001",
        "element_id": "COMP-ACCOUNT",
        "element_name": "Account Service",
        "detailed_responsibility": "Validate the bearer token and compare the authenticated customer ID with the account owner before returning data."
      }
    ],
    "api_operations": [
      {
        "operation_id": "viewAccount",
