{
  "project_id": "LIBRARY-QUALITY-001",
  "functional_requirements": [
    {
      "requirement_id": "FR-001",
      "statement": "A member shall borrow an available book.",
      "priority": "High"
    },
    {
      "requirement_id": "FR-002",
      "statement": "A member shall view their borrowing record.",
      "priority": "Medium"
    }
  ],
  "non_functional_requirements": [
    {
      "requirement_id": "NFR-SEC-001",
      "statement": "Members must authenticate and may access only their own borrowing records.",
      "category": "Security"
    },
    {
      "requirement_id": "NFR-FT-001",
      "statement": "Borrowing operations shall document invalid input, unavailable books and temporary service failures.",
      "category": "Fault Tolerance"
    }
  ],
  "architecture": {
    "architecture_id": "ARCH-LIBRARY-001",
    "selected_architecture": "Modular Architecture",
    "elements": [
      {
        "element_id": "COMP-BORROWING",
        "name": "Borrowing Service",
        "type": "Service",
        "main_responsibility": "Authenticate members, verify borrowing-record ownership and create loans only for available books."
      }
    ]
  },
  "database": {
    "entities": [
      {
        "entity_id": "DB-BOOK",
        "name": "Book",
        "attributes": [
          "book_id",
          "title",
          "status"
        ],
        "primary_key": "book_id",
        "foreign_keys": [],
        "constraints": []
      },
      {
        "entity_id": "DB-MEMBER",
        "name": "Member",
        "attributes": [
          "member_id",
          "name"
        ],
        "primary_key": "member_id",
        "foreign_keys": [],
        "constraints": []
      },
      {
        "entity_id": "DB-LOAN",
        "name": "Loan",
        "attributes": [
          "loan_id",
          "book_id",
          "member_id",
          "borrowed_at",
          "due_date",
          "status"
        ],
        "primary_key": "loan_id",
        "foreign_keys": [
          "book_id -> Book",
          "member_id -> Member"
        ],
        "constraints": [
          "A book may have only one active loan.",
          "due_date must be later than borrowed_at."
        ]
      }
    ],
    "relationships": [
      "Member owns Loan",
      "Loan references Book"
    ],
    "constraints": []
  },
  "api_component_design": {
    "responsibilities": [
      {
        "requirement_id": "FR-001",
        "element_id": "COMP-BORROWING",
        "element_name": "Borrowing Service",
        "detailed_responsibility": "Create a loan using the authenticated member ID. Check book availability and create the loan atomically.",
        "mapping_reason": "Implements book borrowing."
      },
      {
        "requirement_id": "FR-002",
        "element_id": "COMP-BORROWING",
        "element_name": "Borrowing Service",
        "detailed_responsibility": "Return a loan only when its member_id matches the authenticated member.",
        "mapping_reason": "Implements access to the member's borrowing record."
      }
    ],
    "api_operations": [
      {
        "operation_id": "borrowBook",
        "requirement_id": "FR-001",
        "element_id": "COMP-BORROWING",
        "method": "POST",
        "path": "/loans",
        "security": {
          "authentication": "bearer",
          "roles": [
            "member"
          ],
          "access_rules": [
            "Validate the bearer token.",
            "Derive member_id from the authenticated identity.",
            "Reject client-supplied member_id, loan_id and status."
          ]
        },
        "request_schema": {
          "book_id": "string"
        },
        "response_schema": {
          "loan_id": "string",
          "due_date": "string"
        },
        "error_responses": {
          "400": "Invalid book ID or unsupported request fields",
          "401": "Authentication required",
          "403": "Member role required",
          "404": "Book not found",
          "409": "Book is already borrowed",
          "503": "Borrowing service temporarily unavailable"
        }
      },
      {
        "operation_id": "viewLoan",
        "requirement_id": "FR-002",
        "element_id": "COMP-BORROWING",
        "method": "GET",
        "path": "/loans/{loan_id}",
        "security": {
          "authentication": "bearer",
          "roles": [
            "member"
          ],
          "access_rules": [
            "Validate the bearer token.",
            "Require loan.member_id to match the authenticated member."
          ]
        },
        "parameters": [
          {
            "name": "loan_id",
            "location": "path",
            "type": "string",
            "required": true
          }
        ],
        "request_schema": {},
        "response_schema": {
          "loan_id": "string",
          "book_id": "string",
          "due_date": "string",
          "status": "string"
        },
        "error_responses": {
          "401": "Authentication required",
          "403": "Access to another member's loan is denied",
          "404": "Loan not found"
        }
      }
    ],
    "openapi_document": {
      "openapi": "3.1.0",
      "info": {
        "title": "Library Borrowing API",
        "version": "1.0.0"
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "paths": {
        "/loans": {
          "post": {
            "operationId": "borrowBook",
            "requestBody": {
              "required": true,
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "required": [
                      "book_id"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "book_id": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "responses": {
              "201": {
                "description": "Loan created"
              },
              "400": {
                "description": "Invalid request"
              },
              "401": {
                "description": "Authentication required"
              },
              "403": {
                "description": "Member role required"
              },
              "404": {
                "description": "Book not found"
              },
              "409": {
                "description": "Book already borrowed"
              },
              "503": {
                "description": "Service temporarily unavailable"
              }
            }
          }
        },
        "/loans/{loan_id}": {
          "get": {
            "operationId": "viewLoan",
            "parameters": [
              {
                "name": "loan_id",
                "in": "path",
                "required": true,
                "schema": {
                  "type": "string"
                }
              }
            ],
            "responses": {
              "200": {
                "description": "Member's loan returned"
              },
              "401": {
                "description": "Authentication required"
              },
              "403": {
                "description": "Loan access denied"
              },
              "404": {
                "description": "Loan not found"
              }
            }
          }
        }
      },
      "components": {
        "securitySchemes": {
          "bearerAuth": {
            "type": "http",
            "scheme": "bearer"
          }
        }
      }
    }
  }
}
