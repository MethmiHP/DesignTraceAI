{
  "project_id": "QUALITY-SECURITY-DEMO-001",
  "functional_requirements": [
    {
      "requirement_id": "FR-001",
      "statement": "A customer shall view their bank account.",
      "priority": "High"
    },
    {
      "requirement_id": "FR-002",
      "statement": "A bank administrator shall freeze a bank account by its account ID.",
      "priority": "High"
    },
    {
      "requirement_id": "FR-003",
      "statement": "A customer shall import transaction data into their own bank account from a supplied URL on the external statement provider statements.partner.example. Return only import_id and status.",
      "priority": "High"
    }
  ],
  "non_functional_requirements": [
    {
      "requirement_id": "NFR-SEC-001",
      "statement": "All operations require a validated bearer token. Customers may view or import into an account only when its customer_id matches their authenticated identity. Only administrators may freeze accounts.",
      "category": "Security"
    },
    {
      "requirement_id": "NFR-SEC-002",
      "statement": "Customer identity and account status are protected fields. View responses return only account_id. Freeze accepts no body and changes status only on the server. Import accepts only statement_url; reject extra fields and never return customer_id, credentials, tokens or transaction contents.",
      "category": "Security"
    },
    {
      "requirement_id": "NFR-SEC-003",
      "statement": "Statement import is resource-intensive and could exhaust capacity if automated. Enforce five imports per customer per hour, one active import per customer, a 256 KB request limit, a 1 MB upstream response limit and a five-second upstream timeout; reject excess usage with 429.",
      "category": "Security"
    },
    {
      "requirement_id": "NFR-SEC-004",
      "statement": "For statement_url accept only HTTPS on statements.partner.example port 443. Reject credentials and redirects. Validate DNS and the connection destination; reject private, loopback, link-local and reserved addresses.",
      "category": "Security"
    },
    {
      "requirement_id": "NFR-SEC-005",
      "statement": "Treat the external statement API as untrusted. Verify TLS certificates, use a server-held integration credential that is never returned, never forward customer bearer tokens, and validate external JSON types, allowed fields and account ownership before storing data. Reject invalid responses with 502.",
      "category": "Security"
    }
  ],
  "architecture": {
    "selected_architecture": "Modular Architecture",
    "elements": [
      {
        "element_id": "COMP-ACCOUNT",
        "name": "Account Service",
        "type": "Service",
        "main_responsibility": "Enforce bearer authentication, account ownership and administrator-only freezing. Reject unexpected request properties and return only explicitly allowed response fields."
      },
      {
        "element_id": "COMP-IMPORT",
        "name": "Statement Import Service",
        "type": "Service",
        "main_responsibility": "Fetch statement data from external statements.partner.example. Enforce the import quotas, URL/DNS restrictions, TLS verification, integration credential isolation, response validation and size/time limits specified in NFR-SEC-003 through NFR-SEC-005."
      }
    ]
  },
  "database": {
    "entities": [
      {
        "entity_id": "DB-ACCOUNT",
        "name": "Account",
        "attributes": [
          "account_id",
          "customer_id",
          "status"
        ],
        "primary_key": "account_id",
        "foreign_keys": [],
        "constraints": []
      },
      {
        "entity_id": "DB-IMPORT",
        "name": "Statement Import",
        "attributes": [
          "import_id",
          "account_id",
          "status"
        ],
        "primary_key": "import_id",
        "foreign_keys": [
          "account_id -> Account"
        ],
        "constraints": []
      }
    ],
    "relationships": [],
    "constraints": []
  },
  "api_component_design": {
    "responsibilities": [
      {
        "requirement_id": "FR-001",
        "element_id": "COMP-ACCOUNT",
        "element_name": "Account Service",
        "detailed_responsibility": "Validate the bearer token and compare the authenticated customer ID with the account owner before returning data."
      },
      {
        "requirement_id": "FR-002",
        "element_id": "COMP-ACCOUNT",
        "detailed_responsibility": "Allow only authenticated administrators to freeze accounts; derive status on the server."
      },
      {
        "requirement_id": "FR-003",
        "element_id": "COMP-IMPORT",
        "detailed_responsibility": "Import statements for the authenticated account owner. Enforce the supplied quota, destination and third-party trust controls."
      }
    ],
    "api_operations": [
      {
        "operation_id": "viewAccount",
        "requirement_id": "FR-001",
        "element_id": "COMP-ACCOUNT",
        "method": "GET",
        "path": "/accounts/{account_id}",
        "security": {
          "authentication": "bearer",
          "roles": [
            "customer"
          ],
          "access_rules": [
            "Allow access only when account.customer_id matches the authenticated customer."
          ]
        },
        "parameters": [
          {
            "name": "account_id",
            "location": "path",
            "type": "string",
            "required": true
          }
        ],
        "request_schema": {},
        "response_schema": {
          "account_id": "string"
        },
        "error_responses": {
          "401": "Authentication required",
          "403": "Account access denied",
          "404": "Account not found"
        }
      },
      {
        "operation_id": "freezeAccount",
        "requirement_id": "FR-002",
        "element_id": "COMP-ACCOUNT",
        "method": "POST",
        "path": "/accounts/{account_id}/freeze",
        "security": {
          "authentication": "bearer",
          "roles": [
            "administrator"
          ],
          "access_rules": [
            "Require the verified administrator role; deny customer callers. Set status to frozen on the server."
          ]
        },
        "parameters": [
          {
            "name": "account_id",
            "location": "path",
            "type": "string",
            "required": true
          }
        ],
        "request_schema": {},
        "response_schema": {
          "account_id": "string",
          "status": "string"
        },
        "error_responses": {
          "401": "Authentication required",
          "403": "Administrator role required",
          "404": "Account not found"
        }
      },
      {
        "operation_id": "importStatement",
        "requirement_id": "FR-003",
        "element_id": "COMP-IMPORT",
        "method": "POST",
        "path": "/accounts/{account_id}/statement-imports",
        "security": {
          "authentication": "bearer",
          "roles": [
            "customer"
          ],
          "access_rules": [
            "Verify target account ownership before fetching. Enforce NFR-SEC-003 quotas and NFR-SEC-004 destination restrictions; validate third-party data per NFR-SEC-005."
          ]
        },
        "parameters": [
          {
            "name": "account_id",
            "location": "path",
            "type": "string",
            "required": true
          }
        ],
        "request_schema": {
          "statement_url": "string"
        },
        "response_schema": {
          "import_id": "string",
          "status": "string"
        },
        "error_responses": {
          "400": "Invalid URL or extra fields",
          "401": "Authentication required",
          "403": "Account ownership required",
          "404": "Account not found",
          "413": "Payload too large",
          "429": "Import limit exceeded",
          "502": "Invalid upstream data",
          "504": "Upstream timeout"
        }
      }
    ],
