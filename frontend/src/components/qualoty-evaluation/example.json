  "architecture": {
    "selected_architecture": "Modular Architecture",
    "elements": [
      {
        "element_id": "COMP-ACCOUNT",
        "name": "Account Service",
        "type": "Service",
        "main_responsibility": "Retrieve accounts after validating the bearer token and verifying customer ownership."
      }
    ]
  },
  "database": {
    "entities": [
      {
        "entity_id": "DB-ACCOUNT",
        "name": "Account",
        "attributes": [
          "account_id",
          "customer_id"
