          "403": "Account access denied",
          "404": "Account not found"
        }
      }
    ],
    "openapi_document": {
      "openapi": "3.1.0",
      "info": {
        "title": "Account API",
        "version": "1.0.0"
      },
      "paths": {
        "/accounts/{account_id}": {
          "get": {
            "operationId": "viewAccount",
            "security": [
              {
                "bearerAuth": []
              }
            ],
            "parameters": [
              {
                "name": "account_id",
                "in": "path",
                "required": true,
                "schema": {
                  "type": "string"
                }
              }
            ],
            "responses": {
              "200": {
                "description": "Account returned"
              },
              "401": {
                "description": "Authentication required"
              },
              "403": {
                "description": "Account access denied"
              },
              "404": {
                "description": "Account not found"
              }
            }
          }
        }
      },
      "components": {
